 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Notebook 5: Defense Mechanisms\n",
    "\n",
    "Demonstrate all 8 defense types against attacks.\n",
    "\n",
    "**Defenses:**\n",
    "- Input Sanitization\n",
    "- Temporal Consistency\n",
    "- Multi-Sensor Agreement\n",
    "- Robust Clustering\n",
    "- Anomaly Detection\n",
    "- Certified Defense (Randomized Smoothing)\n",
    "- Adversarial Training\n",
    "- Ensemble Defense"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "sys.path.insert(0, '../src')\n",
    "\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from data_loader import SensorDataLoader\n",
    "from attacks.camera_attacks import CameraAdversarialAttacker, AttackType\n",
    "from defenses.defense_mechanisms import DefensePipeline, DefenseType\n",
    "from evaluation.metrics import TrackingMetrics\n",
    "\n",
    "%matplotlib inline"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5.1 Load Data and Create Attack"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "SCENARIO = 'scenario2'\n",
    "DATA_PATH = f'../data/sensor_fusion_dataset/{SCENARIO}'\n",
    "\n",
    "loader = SensorDataLoader(DATA_PATH)\n",
    "detections = loader.load_all_detections()\n",
    "ground_truth = loader.load_ground_truth()\n",
    "\n",
    "# Create attacked data (FGSM on IR Camera)\n",
    "attacker = CameraAdversarialAttacker(epsilon=0.05)\n",
    "attacked = {sid: df.copy() for sid, df in detections.items()}\n",
    "attacked[3] = attacker.attack_detections(detections[3].copy(), AttackType.FGSM, sensor_id=3)\n",
    "\n",
    "print(\"Benign vs Attacked IR Camera:\")\n",
    "print(f\"  Benign:  {len(detections[3])} detections\")\n",
    "print(f\"  Attacked: {len(attacked[3])} detections\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5.2 Initialize Defense Pipeline"
   ]
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "pipeline = DefensePipeline()\n",
    "print(\"Available defenses:\")\n",
    "for d in DefenseType:\n",
    "    print(f\"  - {d.name}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5.3 Apply Individual Defenses"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Test each defense individually\n",
    "defense_results = {}\n",
    "\n",
    "for defense_type in DefenseType:\n",
    "    defended = pipeline.defend_detections(attacked, defense_type, ground_truth)\n",
    "    defense_results[defense_type.name] = defended\n",
    "    \n",
    "    # Compute recovery for IR camera\n",
    "    benign_bearings = detections[3]['bearing'].values\n",
    "    attacked_bearings = attacked[3]['bearing'].values\n",
    "    defended_bearings = defended[3]['bearing'].values\n",
    "    \n",
    "    attack_shift = np.mean(np.abs(attacked_bearings - benign_bearings))\n",
    "    defense_shift = np.mean(np.abs(defended_bearings - benign_bearings))\n",
    "    recovery = (1 - defense_shift / attack_shift) * 100 if attack_shift > 0 else 100\n",
    "    \n",
    "    print(f\"{defense_type.name:25s}: Attack shift={attack_shift:.4f}, Defense shift={defense_shift:.4f}, Recovery={recovery:.1f}%\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5.4 Visualize Defense Recovery"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from visualization.plot_utils import plot_defense_recovery\n",
    "\n",
    "# Show best defense recovery\n",
    "best_defense = DefenseType.TEMPORAL_CONSISTENCY\n",
    "defended = defense_results[best_defense.name]\n",
    "\n",
    "fig = plot_defense_recovery(detections, attacked, defended, sensor_id=3, \n",
    "                           title=f'IR Camera Defense: {best_defense.name}')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5.5 Compare All Defenses"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Compare defense effectiveness across all sensors\n",
    "fig, axes = plt.subplots(2, 4, figsize=(20, 10))\n",
    "axes = axes.flatten()\n",
    "\n",
    "for idx, (defense_name, defended) in enumerate(defense_results.items()):\n",
    "    ax = axes[idx]\n",
    "    \n",
    "    # Plot benign, attacked, defended for IR camera\n",
    "    ax.scatter(detections[3]['x_piren'], detections[3]['y_piren'], \n",
    "              s=3, alpha=0.3, c='blue', label='Benign')\n",
    "    ax.scatter(attacked[3]['x_piren'], attacked[3]['y_piren'], \n",
    "              s=3, alpha=0.3, c='red', label='Attacked')\n",
    "    ax.scatter(defended[3]['x_piren'], defended[3]['y_piren'], \n",
    "              s=3, alpha=0.3, c='green', label='Defended')\n",
    "    \n",
    "    ax.set_title(defense_name.replace('_', ' '))\n",
    "    ax.set_xlabel('East (m)')\n",
    "    ax.set_ylabel('North (m)')\n",
    "    ax.legend()\n",
    "    ax.grid(True)\n",
    "    ax.set_aspect('equal')\n",
    "\n",
    "plt.suptitle('Defense Comparison: IR Camera FGSM Attack', fontsize=14)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5.6 Certified Defense Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from defenses.defense_mechanisms import CertifiedDefense\n",
    "\n",
    "# Test certified defense with different radii\n",
    "radii = [0.01, 0.02, 0.05, 0.1, 0.15, 0.2]\n",
    "certified_results = []\n",
    "\n",
    "for radius in radii:\n",
    "    cert_def = CertifiedDefense(certified_radius=radius)\n",
    "    defended = cert_def.defend(attacked, ground_truth)\n",
    "    \n",
    "    # Compute metrics\n",
    "    benign_bearings = detections[3]['bearing'].values[:100]\n",
    "    defended_bearings = defended[3]['bearing'].values[:100]\n",
    "    rmse = np.sqrt(np.mean((defended_bearings - benign_bearings)**2))\n",
    "    \n",
    "    certified_results.append({'radius': radius, 'rmse': rmse})\n",
    "    print(f\"Radius={radius:.2f}: RMSE={rmse:.4f}\")\n",
    "\n",
    "# Plot\n",
    "radii_vals = [r['radius'] for r in certified_results]\n",
    "rmses = [r['rmse'] for r in certified_results]\n",
    "\n",
    "plt.figure(figsize=(10, 6))\n",
    "plt.plot(radii_vals, rmses, 'bo-', linewidth=2, markersize=10)\n",
    "plt.xlabel('Certified Radius')\n",
    "plt.ylabel('RMSE (rad)')\n",
    "plt.title('Certified Defense: Radius vs Recovery Quality')\n",
    "plt.grid(True)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5.7 Adversarial Training Defense"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from defenses.defense_mechanisms import AdversarialTraining\n",
    "\n",
    "# Train adversarial defense\n",
    "adv_train = AdversarialTraining(augmentation_ratio=0.3)\n",
    "adv_train.train(detections, attacked)\n",
    "\n",
    "# Apply defense\n",
    "defended_adv = adv_train.defend(attacked)\n",
    "\n",
    "# Compare\n",
    "fig, (ax1, ax2, ax3) = plt.subplots(1, 3, figsize=(18, 6))\n",
    "\n",
    "ax1.scatter(detections[3]['x_piren'], detections[3]['y_piren'], s=5, alpha=0.5, c='blue')\n",
    "ax1.set_title('Benign')\n",
    "ax1.set_xlabel('East (m)')\n",
    "ax1.set_ylabel('North (m)')\n",
    "ax1.grid(True)\n",
    "ax1.set_aspect('equal')\n",
    "\n",
    "ax2.scatter(attacked[3]['x_piren'], attacked[3]['y_piren'], s=5, alpha=0.5, c='red')\n",
    "ax2.set_title('Attacked (FGSM)')\n",
    "ax2.set_xlabel('East (m)')\n",
    "ax2.set_ylabel('North (m)')\n",
    "ax2.grid(True)\n",
    "ax2.set_aspect('equal')\n",
    "\n",
    "ax3.scatter(defended_adv[3]['x_piren'], defended_adv[3]['y_piren'], s=5, alpha=0.5, c='green')\n",
    "ax3.set_title('Adversarial Training Defense')\n",
    "ax3.set_xlabel('East (m)')\n",
    "ax3.set_ylabel('North (m)')\n",
    "ax3.grid(True)\n",
    "ax3.set_aspect('equal')\n",
    "\n",
    "plt.suptitle('Adversarial Training Defense', fontsize=14)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  }
 ],
